{
  "name": "amor-workforce",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "create-user": "node --env-file-if-exists=.env.local --import tsx scripts/create-user.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "lucide-react": "0.468.0",
    "next": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
